@model IEnumerable<A_Visit_To_Georgia.Models.Bokningbord>
@{
    ViewData["Title"] = "Bokningar";
}

<div class="container">
    <div class="section bookings-card">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-3">
            <h1 class="m-0">Bokningar</h1>
            <a asp-controller="Home" asp-action="Bokabord" class="btn btn-primary">Ny bokning</a>
        </div>

        @if (TempData["Saved"] is string msg)
        {
            <div class="alert alert-success py-2 mb-3" role="alert">@msg</div>
        }

        @if (!(Model?.Any() ?? false))
        {
            <p class="mb-0">Inga bokningar ännu. Klicka på <strong>Ny bokning</strong> för att lägga till den första.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle bookings-table mb-0">
                    <thead>
                    <tr>
                        <th>#</th>
                        <th>Namn</th>
                        <th>Gäster</th>
                        <th>Datum &amp; tid</th>
                        <th>Kommentar</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var b in Model.OrderBy(x => x.Datum).ThenBy(x => x.Tid))
                    {
                        <tr>
                            <td>@b.Id</td>
                            <td>@b.Namn</td>
                            <td>
                                <span class="badge bg-light text-dark fw-semibold">@b.AntalPersoner</span>
                            </td>
                            <td>
                                <span class="d-inline-block me-1">@b.Datum.ToString("yyyy-MM-dd")</span>
                                <span class="time-chip">@b.Tid</span>
                            </td>
                            <td>@b.Kommentar</td>

                            <td class="text-end">
                                <a class="btn btn-warning btn-sm" asp-action="Edit" asp-route-id="@b.Id">Ändra</a>

                                <form asp-action="Delete" asp-route-id="@b.Id" method="post" style="display:inline-block;"
                                      onsubmit="return confirm('Vill du ta bort bokningen?');">
                                    <button class="btn btn-danger btn-sm" type="submit">Radera</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>

                </table>
            </div>
        }
    </div>
</div>