@model A_Visit_To_Georgia.Models.Bokningbord

<h1>Radera bokning</h1>

<p>Är du säker att du vill ta bort bokningen för <strong>@Model.Namn</strong>?</p>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button class="btn btn-danger" type="submit">Ta bort</button>
    <a class="btn btn-secondary" asp-action="Index">Avbryt</a>
</form>