@model A_Visit_To_Georgia.Models.MenuItem
@{
    ViewData["Title"] = "Redigera rätt";
}
<div class="container">
    <div class="section form-card">
        <h1 class="mb-3">Redigera rätt</h1>

        <form asp-action="MenuEdit" method="post">
            <input type="hidden" asp-for="Id"/>

            <div class="mb-3">
                <label class="form-label">Namn</label>
                <input asp-for="Namn" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Kategori</label>
                <input asp-for="Kategori" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Pris</label>
                <input asp-for="Pris" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Beskrivning</label>
                <textarea asp-for="Beskrivning" rows="4" class="form-control"></textarea>
            </div>

            <button class="btn btn-primary" type="submit">Spara</button>
            <a asp-action="Menu" class="btn btn-secondary ms-2">Avbryt</a>
        </form>
    </div>
</div>