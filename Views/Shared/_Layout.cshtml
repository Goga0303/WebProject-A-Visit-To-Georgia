<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - A Visit To Georgia</title>

   
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
<header class="bg-dark text-white py-3">
    <nav class="container d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
            <div class="menu-icon" id="menu-icon" aria-label="Meny" role="button" tabindex="0">
                <div class="bar"></div><div class="bar"></div><div class="bar"></div>
            </div>
            <a asp-controller="Home" asp-action="Index" class="text-white text-decoration-none">
                <h3 class="m-0">A Visit To Georgia</h3>
            </a>
        </div>

        <ul class="nav">
            <li class="nav-item">
                <a class="nav-link text-white" asp-controller="Home" asp-action="Index">Startsida</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white" asp-controller="Home" asp-action="Bokabord">Boka bord</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white" asp-controller="Databas" asp-action="Index">Bokningar (Admin)</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white" asp-controller="Databas" asp-action="Menu">Meny (Admin)</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white" asp-controller="Home" asp-action="SeVarMeny">Se vår meny</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-white" asp-controller="Home" asp-action="KontaktaOss">Kontakta oss</a>
            </li>
        </ul>
    </nav>
</header>

<main class="container my-4">
    @RenderBody()
</main>

<footer class="bg-dark text-white text-center py-3">
    <small>Välkommen Mån–Fre 15:00–23:00, Helgdagar 18:00–00:00</small>
</footer>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>


<script src="~/js/site.js" asp-append-version="true"></script>


@RenderSection("Scripts", required: false)
</body>
</html>
